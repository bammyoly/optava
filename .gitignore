# ══════════════════════════════════════════════
#  Optava — Root .gitignore
# ══════════════════════════════════════════════

# ── Node modules ──────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/

# ── Environment files ─────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
backend/.env
backend/.env.local
backend/.env.production

# ── Build outputs ─────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
backend/dist/
backend/build/

# ── TypeScript ────────────────────────────────
*.tsbuildinfo
frontend/next-env.d.ts

# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS files ──────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / Editor ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Package manager locks (keep one) ──────────
# Keep package-lock.json, ignore others
yarn.lock
pnpm-lock.yaml
.yarn/
.pnp.*

# ── Testing ───────────────────────────────────
coverage/
.nyc_output/
frontend/coverage/
backend/coverage/

# ── Misc ──────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
*.tgz
*.tar.gz
Readmes
Readme2